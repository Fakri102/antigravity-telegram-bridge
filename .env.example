# ==========================================
# ANTIGRAVITY TELEGRAM BRIDGE CONFIGURATION
# ==========================================

# 1. Masukkan Token Bot Telegram dari @BotFather
# Contoh: 123456789:ABCdefGhIJKlmNoPQRstuvWXyz
TELEGRAM_BOT_TOKEN=

# 2. Masukkan ID Telegram Anda dari @userinfobot (hanya ID ini yang bisa akses komputer Anda)
# Anda juga bisa membiarkannya kosong dulu, lalu kirim /start ke bot untuk melihat ID Anda.
# Bisa lebih dari 1 ID dipisah koma (contoh: 123456789,987654321)
ALLOWED_TELEGRAM_USER_ID=

# 3. Direktori default saat bot dijalankan (default: home directory)
ANTIGRAVITY_WORKSPACE=

# 4. Path ke binary agy CLI
AGY_BINARY_PATH=/.local/bin/agy
