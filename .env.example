# ==========================================
# ANTIGRAVITY TELEGRAM BRIDGE CONFIGURATION
# ==========================================

# 1. Masukkan Token Bot Telegram dari @BotFather
# Contoh: 123456789:ABCdefGhIJKlmNoPQRstuvWXyz
TELEGRAM_BOT_TOKEN=

# 2. Masukkan ID Telegram Anda dari @userinfobot (hanya ID ini yang bisa akses komputer/server Anda)
# Bisa lebih dari 1 ID dipisah koma (contoh: 123456789,987654321)
ALLOWED_TELEGRAM_USER_ID=

# 3. Model Gemini AI Terbaru untuk Antigravity (Default: gemini-3.7-flash)
# Pilihan: gemini-3.7-flash, gemini-2.5-pro, gemini-2.5-flash
ANTIGRAVITY_MODEL=gemini-3.7-flash

# 4. Tingkat Penalaran / Reasoning Effort (low, medium, high - Default: high)
ANTIGRAVITY_EFFORT=high

# 5. Direktori default saat bot dijalankan (kosongkan untuk default home directory: ~)
ANTIGRAVITY_WORKSPACE=

# 6. Path ke binary agy CLI (kosongkan jika agy ada di PATH / ~/.local/bin/agy)
AGY_BINARY_PATH=

# 7. Opsional: Gemini API Key untuk transkripsi audio tingkat lanjut
GEMINI_API_KEY=

# 8. Timeout eksekusi dalam detik (default: 300)
ANTIGRAVITY_TIMEOUT=300

# 9. Level Log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
